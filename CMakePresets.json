{
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "checked",
      "inherits": "debug",
      "cacheVariables": { "FIBER_CONTEXT_ASM_CANARIES": "ON" }
    },
    {
      "name": "release",
      "inherits": "debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw-toolchain",
      "inherits": "debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "FIBER_CONTEXT_TOOLCHAIN_ONLY": "ON" }
    },
    {
      "name": "mingw-cross-toolchain",
      "inherits": "debug",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
      "cacheVariables": { "FIBER_CONTEXT_TOOLCHAIN_ONLY": "ON" }
    },
    {
      "name": "asan",
      "inherits": "checked",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "checked", "configurePreset": "checked" },
    { "name": "release", "configurePreset": "release" },
    {
      "name": "mingw-toolchain", "configurePreset": "mingw-toolchain",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw-cross-toolchain", "configurePreset": "mingw-cross-toolchain",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "asan", "configurePreset": "asan",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "checked", "configurePreset": "checked", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    {
      "name": "asan",
      "configurePreset": "asan",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "environment": { "ASAN_OPTIONS": "detect_stack_use_after_return=1" },
      "output": { "outputOnFailure": true }
    }
  ]
}
